      "end_iso": "2023",
      "id": "fluid-sim-2d",
      "image": "assets/projects/fluid-sim-2d.jpg",
      "meta_line": null,
      "name": "2D Fluid Simulation on the GPU",
      "ongoing": false,
      "start": "2023",
      "start_display": "2023",
      "start_iso": "2023",
      "summary": "An incompressible fluid simulation built on Vulkan compute shaders. It operates on a two-dimensional grid and supports solid and fluid cells with various initial conditions. Performance bottlenecks were analyzed with NVIDIA Nsight Graphics and optimized through ghost zoning, kernel decomposition and loop unrolling.",
      "tags": [
        "C++",
        "Vulkan",
        "CFD"
      ],
      "url": "https://github.com/dom-wuest/FluidSim2D",
      "url_label": "github.com/dom-wuest/FluidSim2D"
